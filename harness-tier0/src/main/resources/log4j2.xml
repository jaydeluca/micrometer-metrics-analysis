<?xml version="1.0" encoding="UTF-8"?>
<!-- status="OFF" suppresses Log4j2's startup StatusLogger noise. Root level is raised to TRACE
     by the harness while driving so all per-level counters materialize. -->
<Configuration status="OFF">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
